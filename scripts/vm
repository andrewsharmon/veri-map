#!/usr/bin/env python3
"""veri-map helper: questions, nodes, claims, notebooks and runs.

Stdlib only (Python 3.9+). The scaffold (this repo) is public; all research
lives in lab/, a separate private git repo that the scaffold ignores. Every
commit vm makes goes to the lab repo.

Nodes are named by their path under lab/questions/ (e.g. cache-tuning/baseline);
a full path (lab/questions/cache-tuning/baseline) or a path relative to the
current directory also works.
"""
import shutil
import argparse
import datetime as dt
import hashlib
import os
import re
import subprocess
import sys
from pathlib import Path

STATUSES = ("open", "active", "blocked", "concluded", "abandoned")
CLOSED = ("concluded", "abandoned")
NODE_FILES = ("DIRECTIVE.md", "NOTEBOOK.md", "FINDINGS.md")
NON_NODE_DIRS = {"runs", "assets"}
STALE_HOURS = 24
SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")
CLAIM_FMT = "%Y-%m-%dT%H:%M"

ROOT = Path(__file__).resolve().parent.parent   # the public scaffold
LAB = ROOT / "lab"                              # the private lab repo
QUESTIONS = LAB / "questions"
NOW = dt.datetime.now()


# ---------------------------------------------------------------- utilities

def die(msg):
    print(f"vm: {msg}", file=sys.stderr)
    sys.exit(1)


def git(*args, check=True, cwd=None):
    """Run git in the lab repo (or `cwd`)."""
    r = subprocess.run(["git", *args], cwd=cwd or LAB, capture_output=True, text=True)
    if check and r.returncode != 0:
        die(f"git {' '.join(args)} failed:\n{r.stderr.strip()}")
    return r.stdout.strip() if r.returncode == 0 else None


def git_show(spec):
    """File contents at a git revision spec (e.g. 'HEAD:path', ':path'), or None."""
    r = subprocess.run(["git", "show", spec], cwd=LAB, capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else None


def rel(p):
    """Path for display, relative to the scaffold root."""
    return p.relative_to(ROOT).as_posix()


def gitpath(p):
    """Path inside the lab repo."""
    return p.relative_to(LAB).as_posix()


def check_slug(slug):
    if not SLUG_RE.match(slug):
        die(f"bad slug {slug!r}: use lowercase letters, digits and dashes")


def moment(fmt):
    """Render an Obsidian/moment.js date format with the tokens the templates use."""
    for a, b in (("YYYY", "%Y"), ("MM", "%m"), ("DD", "%d"), ("HH", "%H"), ("mm", "%M"), ("ss", "%S")):
        fmt = fmt.replace(a, b)
    return NOW.strftime(fmt)


def render(template, **values):
    text = (ROOT / "_meta" / "templates" / template).read_text()
    text = re.sub(
        r"\{\{(date|time)(?::([^}]+))?\}\}",
        lambda m: moment(m.group(2) or ("YYYY-MM-DD" if m.group(1) == "date" else "HH:mm")),
        text,
    )
    for k, v in values.items():
        text = text.replace("{{%s}}" % k, v)
    return text


def commit(paths, message, enabled=True):
    if not enabled:
        return
    if not paths:
        return
    paths = sorted({gitpath(p) if isinstance(p, Path) else p for p in paths})
    git("add", "-A", "--", *paths)
    if git("diff", "--cached", "--quiet", "--", *paths, check=False) is not None:
        return  # nothing staged for these paths
    git("commit", "-q", "-m", message, "--", *paths)
    print(f"committed: {message}")


# ------------------------------------------------------- markdown structure

def split_fm(text):
    if text.startswith("---\n"):
        end = text.find("\n---\n", 4)
        if end != -1:
            return text[4:end], text[end + 5:]
    return "", text


def parse_fm(text):
    fm, _ = split_fm(text)
    out = {}
    for line in fm.splitlines():
        m = re.match(r"^([A-Za-z_][\w-]*):\s*(.*)$", line)
        if m:
            out[m.group(1)] = m.group(2).strip().strip("\"'")
    return out


def set_fm(path, **fields):
    fm, body = split_fm(path.read_text())
    lines = fm.splitlines()
    for k, v in fields.items():
        new = f"{k}: {v}".rstrip()
        for i, line in enumerate(lines):
            if re.match(rf"^{re.escape(k)}:", line):
                lines[i] = new
                break
        else:
            lines.append(new)
    path.write_text("---\n" + "\n".join(lines) + "\n---\n" + body)


def strip_comments(s):
    return re.sub(r"<!--.*?-->", "", s, flags=re.S)


def section_span(text, name):
    m = re.search(rf"^## {re.escape(name)}[ \t]*$", text, re.M)
    if not m:
        return None
    n = re.search(r"^## ", text[m.end():], re.M)
    return m.end(), (m.end() + n.start() if n else len(text))


def section(text, name):
    span = section_span(text, name)
    return text[span[0]:span[1]] if span else ""


def clean(s):
    return strip_comments(s).strip()


def bullets(s):
    return [l.strip() for l in strip_comments(s).splitlines()
            if re.match(r"^\s*[-*] \S", l)]


def question_of(text):
    """The `question` property; older directives kept it in a ## Question section."""
    q = parse_fm(text).get("question", "") or clean(section(text, "Question"))
    return " ".join(q.split())


def yaml_str(s):
    return '"%s"' % " ".join(s.split()).replace('"', "'")


def slugify(name):
    s = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")
    if len(s) > 48:
        s = s[:49].rsplit("-", 1)[0]  # cut at a word boundary
    return s[:48] or "untitled"


def append_to_section(text, name, line, table=False):
    """Insert `line` at the end of section `name` (after the last table row if table)."""
    span = section_span(text, name)
    if not span:
        return text.rstrip("\n") + f"\n\n## {name}\n\n{line}\n"
    start, end = span
    lines = text[start:end].rstrip("\n").split("\n")
    rows = [i for i, l in enumerate(lines) if l.lstrip().startswith("|")]
    if table and rows:
        lines.insert(rows[-1] + 1, line)
    else:
        lines.append(line)
    tail = "\n\n" if end < len(text) else "\n"
    return text[:start] + "\n".join(lines) + tail + text[end:]


def entries(notebook_text):
    _, body = split_fm(notebook_text)
    parts = re.split(r"^(?=## )", body, flags=re.M)
    return [p.rstrip() for p in parts if p.startswith("## ")]


def entry_field(entry, name):
    m = re.search(rf"^\*\*{re.escape(name)}:\*\*[ \t]*(.*)$", entry, re.M)
    return m.group(1).strip() if m else ""


def entry_heading(entry):
    """(author, title) from '## <date> <time> · <author> · <title>'."""
    parts = entry.splitlines()[0][3:].split(" · ", 2)
    return (parts[1].strip(), parts[2].strip()) if len(parts) == 3 else ("", "")


def digest(directive_text):
    """Fingerprint of the parts of a directive that steer work.

    Frontmatter, comments, whitespace, and the Sub-paths / Closed paths sections
    (which agents maintain) are ignored, so the digest changes only when the
    question, scope, restrictions, exit criteria or budget change.
    """
    _, body = split_fm(directive_text)
    for name in ("Sub-paths", "Closed paths"):
        span = section_span(body, name)
        if span:
            body = body[:span[0]] + body[span[1]:]
    steering = question_of(directive_text) + "\n" + " ".join(strip_comments(body).split())
    return hashlib.sha1(steering.encode()).hexdigest()[:10]


# -------------------------------------------------------------------- nodes

class Node:
    def __init__(self, path):
        self.path = path
        self.directive = path / "DIRECTIVE.md"

    @property
    def rel(self):
        return rel(self.path)

    @property
    def id(self):
        """Node name: its path under lab/questions/."""
        return self.path.relative_to(QUESTIONS).as_posix()

    @property
    def text(self):
        return self.directive.read_text() if self.directive.exists() else ""

    @property
    def fm(self):
        return parse_fm(self.text)

    @property
    def status(self):
        return self.fm.get("status", "?")

    @property
    def question(self):
        return question_of(self.text)

    @property
    def flag(self):
        return self.fm.get("flag", "")

    @property
    def changed(self):
        """True if a human edited the directive since an agent last claimed or released it."""
        seen = self.fm.get("seen", "")
        return bool(seen) and seen != digest(self.text)

    @property
    def human_note(self):
        """Title of the last notebook entry if a human wrote it (no agent has replied yet)."""
        ents = entries(self.read("NOTEBOOK.md"))
        if not ents:
            return ""
        author, title = entry_heading(ents[-1])
        return title if author == "human" else ""

    def held_by_other(self, agent=None):
        holder = self.fm.get("claimed_by", "")
        return self.status == "active" and holder != (agent or "") and not self.is_stale()

    @property
    def is_root(self):
        return self.path.parent == QUESTIONS

    @property
    def parent(self):
        return None if self.is_root else Node(self.path.parent)

    def ancestors(self):
        """Root-first list of ancestors, excluding self."""
        chain, n = [], self.parent
        while n:
            chain.append(n)
            n = n.parent
        return list(reversed(chain))

    def children(self):
        return [Node(p) for p in sorted(self.path.iterdir()) if is_node_dir(p)]

    def walk(self, depth=0):
        yield self, depth
        for c in self.children():
            yield from c.walk(depth + 1)

    def read(self, name):
        p = self.path / name
        return p.read_text() if p.exists() else ""

    def claim_age_hours(self):
        try:
            since = dt.datetime.strptime(self.fm.get("claimed_at", ""), CLAIM_FMT)
        except ValueError:
            return None
        return (NOW - since).total_seconds() / 3600

    def is_stale(self):
        age = self.claim_age_hours()
        return self.status == "active" and age is not None and age > STALE_HOURS


def is_node_dir(p):
    return p.is_dir() and p.name not in NON_NODE_DIRS and not p.name.startswith((".", "_"))


def question_roots():
    if not QUESTIONS.exists():
        return []
    return [Node(p) for p in sorted(QUESTIONS.iterdir()) if is_node_dir(p)]


def resolve_node(arg):
    p = Path(arg)
    cands = [p] if p.is_absolute() else [QUESTIONS / p, Path.cwd() / p, ROOT / p, LAB / p]
    for c in cands:
        c = c.resolve()
        if QUESTIONS in c.parents and (c / "DIRECTIVE.md").exists():
            return Node(c)
    die(f"not a node: {arg} (expected a folder under lab/questions/ with a DIRECTIVE.md)")


PARENT_LINK = "Parent: [../DIRECTIVE.md](../DIRECTIVE.md)"
ROOT_LINK = "Parent: [INDEX.md](../../INDEX.md)"


def write_node(path, question=None, sections=None):
    """Create any missing node files from the templates and stamp their `node` property.

    Safe to re-run: existing files keep their content. `question` and `sections`
    ({"In scope": "- …"}) only apply to a newly created DIRECTIVE.md.
    Returns True if anything changed.
    """
    path.mkdir(parents=True, exist_ok=True)
    node, changed = path.relative_to(QUESTIONS).as_posix(), False
    for name in NODE_FILES:
        f = path / name
        new = not f.exists()
        text = render(name) if new else f.read_text()
        if name == "DIRECTIVE.md":
            if new:
                for sec, content in (sections or {}).items():
                    text = append_to_section(text, sec, content)
            if path.parent == QUESTIONS:
                text = text.replace(PARENT_LINK, ROOT_LINK, 1)
        if new or text != f.read_text():
            f.write_text(text)
            changed = True
        fields = {}
        if parse_fm(text).get("node") != node:
            fields["node"] = node
        if new and name == "DIRECTIVE.md" and question:
            fields["question"] = yaml_str(question)
        if fields:
            set_fm(f, **fields)
            changed = True
    return changed


def append_entry(node, agent, title, body=None):
    nb = node.path / "NOTEBOOK.md"
    text = nb.read_text() if nb.exists() else ""
    heading = f"## {NOW.strftime('%Y-%m-%d %H:%M')} · {agent} · {title}"
    if body is None:
        skeleton = render("entry.md").strip("\n").split("\n")[1:]  # template minus its heading
        entry = "\n".join([heading] + skeleton)
    else:
        entry = f"{heading}\n\n{body.strip()}"
    nb.write_text(text.rstrip("\n") + "\n\n" + entry.rstrip() + "\n")
    return heading


# ------------------------------------------------- adopting human-made nodes

def is_tracked(path):
    return git("ls-files", "--error-unmatch", "--", gitpath(path), check=False) is not None


def parse_note(path):
    """A note a human wrote in Obsidian -> (question, {section: content}).

    The question is the `question` property, else the first paragraph, else the
    note's name. Text before the first heading becomes Context; ## In scope,
    ## Restricted, ## Done when, ## Budget and ## Context carry over as-is.
    """
    text = path.read_text()
    _, body = split_fm(text)
    body = strip_comments(body)
    sections = {}
    for name in ("Context", "In scope", "Restricted", "Done when", "Budget"):
        s = section(body, name).strip()
        if s:
            sections[name] = s
    lead = re.split(r"^## ", body, maxsplit=1, flags=re.M)[0]
    lead = "\n".join(l for l in lead.splitlines() if not l.startswith("# ")).strip()
    question = parse_fm(text).get("question", "")
    if not question and lead:
        first, _, lead = lead.partition("\n\n")
        question, lead = " ".join(first.split()), lead.strip()
    if lead:
        sections["Context"] = lead + ("\n\n" + sections["Context"] if "Context" in sections else "")
    return question or path.stem, sections


def loose_notes(d):
    """Markdown files in a folder that are requests for new nodes."""
    skip = set(NODE_FILES) | {"README.md"}
    return [f for f in sorted(d.glob("*.md"))
            if f.name not in skip and not f.name.startswith(("_", ".", "Untitled"))]


def sync():
    """Turn what a human made in Obsidian into proper nodes.

    - A note inside questions/ or a node folder becomes a new child node named
      after the note (the note is folded into the new DIRECTIVE.md).
    - A folder gets a slug name, any missing node files, and a row in its
      parent's Sub-paths. A folder with no DIRECTIVE.md and one note uses that
      note as its directive.
    Returns (log lines, touched paths).
    """
    log, touched = [], []

    def consume(note):
        touched.extend([note] if is_tracked(note) else [])
        note.unlink()

    queue = [QUESTIONS] if QUESTIONS.exists() else []
    while queue:
        d = queue.pop(0)
        for note in loose_notes(d):
            child = d / slugify(note.stem)
            if child.exists():
                log.append(f"skipped {rel(note)}: {rel(child)} already exists")
                continue
            question, sections = parse_note(note)
            write_node(child, question, sections)
            consume(note)
            touched.append(child)
            log.append(f"created {rel(child)}/ from note '{note.name}'")

        for c in sorted(p for p in d.iterdir() if is_node_dir(p)):
            before = len(log)
            if not SLUG_RE.match(c.name):
                new = d / slugify(c.name)
                if new.exists():
                    log.append(f"skipped folder {rel(c)}: {rel(new)} already exists")
                    continue
                if is_tracked(c):
                    touched.append(c)
                c.rename(new)
                log.append(f"renamed {rel(c)} -> {rel(new)}")
                c = new
            directive = c / "DIRECTIVE.md"
            if directive.exists() and parse_fm(directive.read_text()).get("type") != "directive":
                # A note named DIRECTIVE without the template: treat its text as the request.
                question, sections = parse_note(directive)
                directive.unlink()
                write_node(c, question if question != "DIRECTIVE" else c.name.replace("-", " "), sections)
                log.append(f"rebuilt {rel(directive)} from the template")
            elif not directive.exists():
                notes = loose_notes(c)
                if not notes and not any(c.iterdir()):
                    continue  # empty folder, still being set up
                if len(notes) == 1:
                    question, sections = parse_note(notes[0])
                    consume(notes[0])
                else:
                    question, sections = c.name.replace("-", " "), None
                write_node(c, question, sections)
                log.append(f"created node {rel(c)}/")
            elif write_node(c):
                log.append(f"completed node files in {rel(c)}/")

            if d != QUESTIONS:
                parent = Node(d)
                if f"{c.name}/DIRECTIVE.md" not in section(parent.text, "Sub-paths"):
                    q = Node(c).question.replace("|", "\\|")
                    parent.directive.write_text(append_to_section(
                        parent.text, "Sub-paths", f"| [{c.name}]({c.name}/DIRECTIVE.md) | {q} |", table=True))
                    append_entry(parent, "vm", f"Added sub-path `{c.name}` (created in Obsidian)",
                                 f"[{c.name}/DIRECTIVE.md]({c.name}/DIRECTIVE.md): {Node(c).question}")
                    touched.append(d / "DIRECTIVE.md")
                    touched.append(d / "NOTEBOOK.md")
                    log.append(f"listed {c.name} in {rel(d)}/DIRECTIVE.md › Sub-paths")
            if len(log) > before:
                touched.append(c)
            queue.append(c)
    return log, touched


def status_tag(n):
    s = n.status
    if s == "active":
        s += f" by {n.fm.get('claimed_by') or '?'}" + (" (stale)" if n.is_stale() else "")
    if n.flag:
        s += " ⚑"
    if n.changed:
        s += " ✎"
    if n.human_note:
        s += " ✉"
    return s


def embed(markdown):
    """Body of a node file for `context`: no frontmatter or comments, headings demoted one level."""
    body = strip_comments(split_fm(markdown)[1]).strip()
    body = re.sub(r"^(#+ )", r"#\1", body, flags=re.M)
    return re.sub(r"\n{3,}", "\n\n", body)


def short(s, width=90):
    return s if len(s) <= width else s[: width - 1] + "…"


# ----------------------------------------------------------------- commands

def cmd_init(a):
    if (ROOT / ".git").exists():
        git("config", "core.hooksPath", ".githooks", cwd=ROOT)
        print("scaffold: hooks enabled (refuses commits that include lab/)")
    if not LAB.exists():
        shutil.copytree(ROOT / "_meta" / "lab-skeleton", LAB)
        print("created lab/ from _meta/lab-skeleton")
    if not (LAB / ".git").exists():
        git("init", "-q", "-b", "main")
        git("config", "core.hooksPath", "../.githooks")
        git("add", "-A")
        git("commit", "-q", "-m", "Start lab")
        print("lab: new private git repo")
    git("config", "core.hooksPath", "../.githooks")
    print("lab: hooks enabled (append-only notebooks)")
    if a.remote:
        if git("remote", "get-url", "origin", check=False):
            git("remote", "set-url", "origin", a.remote)
        else:
            git("remote", "add", "origin", a.remote)
        print(f"lab: origin = {a.remote}  (push with: git -C lab push -u origin main)")
    elif not git("remote", check=False):
        print("lab: no remote yet — add a PRIVATE one with: scripts/vm init --remote <url>")


def cmd_commit(a):
    node = resolve_node(a.node)
    commit([node.path], f"[{node.id}] {a.message}")


def cmd_question(a):
    check_slug(a.slug)
    path = QUESTIONS / a.slug
    if path.exists():
        die(f"{rel(path)} already exists")
    write_node(path, a.question)
    print(f"created {rel(path)}/  — fill in Context, In scope, Restricted, Done when")
    commit([path], f"[{a.slug}] question: {a.question}", not a.no_commit)


def cmd_path(a):
    parent = resolve_node(a.parent)
    check_slug(a.slug)
    if a.slug in NON_NODE_DIRS:
        die(f"{a.slug!r} is reserved for non-node folders")
    path = parent.path / a.slug
    if path.exists():
        die(f"{rel(path)} already exists")
    write_node(path, a.question)
    scope = a.question.replace("|", "\\|")
    parent.directive.write_text(append_to_section(
        parent.text, "Sub-paths", f"| [{a.slug}]({a.slug}/DIRECTIVE.md) | {scope} |", table=True))
    append_entry(parent, a.agent, f"Spawned sub-path `{a.slug}`",
                 f"[{a.slug}/DIRECTIVE.md]({a.slug}/DIRECTIVE.md): {a.question}")
    print(f"created {rel(path)}/ and listed it in {parent.id}/DIRECTIVE.md")
    print("next: fill in its In scope, Restricted (include sibling ground) and Done when")


def cmd_context(a):
    node = resolve_node(a.node)
    anc = node.ancestors()
    out = [f"# Context · {node.id}", "",
           f"Files: {node.rel}/  ·  generated {NOW.strftime('%Y-%m-%d %H:%M')}  ·  sections are root-first.", ""]

    if node.flag or node.changed or node.human_note:
        out += ["# From the human (act on this first)", ""]
        if node.flag:
            out.append(f"- Flag on this node: {node.flag}")
        if node.human_note:
            out.append(f"- The last notebook entry is a note from the human: \"{node.human_note}\" (shown below)")
        if node.changed:
            out.append(f"- The directive changed since an agent last read it. See what changed with: "
                       f"git -C lab diff -- {gitpath(node.directive)}; "
                       f"git -C lab log -p -3 -- {gitpath(node.directive)}")
        out.append("")

    out += ["# Path from question root", ""]
    for i, n in enumerate(anc + [node]):
        out.append(f"{'  ' * i}- `{n.id}` [{status_tag(n)}] {n.question}")
    out.append("")

    out += ["# Effective restrictions (inherited + own — all binding)", ""]
    any_r = False
    for n in anc + [node]:
        for b in bullets(section(n.text, "Restricted")):
            out.append(f"{b}  ·from `{n.id}`")
            any_r = True
    if not any_r:
        out.append("(none)")
    out.append("")

    budgets = [(n, clean(section(n.text, "Budget"))) for n in anc + [node]]
    budgets = [(n, b) for n, b in budgets if b]
    if budgets:
        out += ["# Budgets in force", ""]
        for n, b in budgets:
            out += [f"From `{n.id}`:", b, ""]

    if node.parent:
        p = node.parent
        out += [f"# Siblings (children of `{p.id}`)", ""]
        sibs = [c for c in p.children() if c.path != node.path]
        for s in sibs:
            out.append(f"- `{s.path.name}` [{status_tag(s)}] {s.question}")
        if not sibs:
            out.append("(none)")
        closed = clean(section(p.text, "Closed paths"))
        if closed:
            out += ["", "Parent's closed paths:", closed]
        out.append("")

    out += [f"# This node's directive (status: {status_tag(node)})", "",
            f"**Question:** {node.question or '(not set — ask the human)'}", "", embed(node.text), ""]
    out += ["# This node's findings", "", embed(node.read("FINDINGS.md")) or "(empty)", ""]

    ents = entries(node.read("NOTEBOOK.md"))
    out += [f"# Recent notebook entries ({min(a.entries, len(ents))} of {len(ents)})", ""]
    out += [embed(e) + "\n" for e in ents[-a.entries:]] if ents else ["(none)", ""]

    kids = node.children()
    if kids:
        out += ["# Children", ""]
        for c in kids:
            out.append(f"- `{c.path.name}` [{status_tag(c)}] {c.question}")
        out.append("")
    print("\n".join(out).rstrip())


def cmd_claim(a):
    node = resolve_node(a.node)
    fm = node.fm
    holder = fm.get("claimed_by", "")
    if not a.force:
        if node.status == "active" and holder and holder != a.agent and not node.is_stale():
            die(f"{node.id} is claimed by {holder} since {fm.get('claimed_at')}; pick another node")
        if node.status in CLOSED:
            die(f"{node.id} is {node.status}; use --force only if a directive reopens it")
    paths = [node.directive]
    notes = []
    if node.flag:
        notes.append(f"Human flag: {node.flag}")
    if node.changed:
        notes.append(f"Directive changed since the last agent visit; review "
                     f"`git -C lab log -p -- {gitpath(node.directive)}`.")
    if node.human_note:
        notes.append(f"Human note in this notebook: \"{node.human_note}\" (previous entry).")
    if notes:
        append_entry(node, a.agent, "Picked up human steering", "\n\n".join(notes))
        paths.append(node.path / "NOTEBOOK.md")
    set_fm(node.directive, status="active", claimed_by=a.agent, claimed_at=NOW.strftime(CLAIM_FMT),
           seen=digest(node.text), updated=NOW.strftime("%Y-%m-%d"))
    print(f"claimed {node.id} for {a.agent}")
    commit(paths, f"[{node.id}] claim: {a.agent}", not a.no_commit)


def cmd_release(a):
    node = resolve_node(a.node)
    holder = node.fm.get("claimed_by", "")
    if holder and holder != a.agent and not a.force:
        die(f"{node.id} is claimed by {holder}, not {a.agent}")
    fields = dict(status=a.status, claimed_by="", claimed_at="",
                  seen=digest(node.text), updated=NOW.strftime("%Y-%m-%d"))
    if not a.keep_flag:
        fields["flag"] = ""
    set_fm(node.directive, **fields)
    paths = [node.directive]
    if a.status in CLOSED and node.parent:
        p = node.parent
        slug = node.path.name
        if f"`{slug}`" not in section(p.text, "Closed paths"):
            p.directive.write_text(append_to_section(
                p.text, "Closed paths",
                f"- `{slug}` — {a.status}: {a.summary or 'TODO one-line result'}. "
                f"[findings]({slug}/FINDINGS.md)"))
            paths.append(p.directive)
            if not a.summary:
                print(f"note: write the one-line result in {p.id}/DIRECTIVE.md › Closed paths")
    print(f"released {node.id} as {a.status}")
    commit(paths, f"[{node.id}] release: {a.status}", not a.no_commit)


def cmd_flag(a):
    node = resolve_node(a.node)
    text = "" if a.clear else " ".join(a.text).replace("\n", " ").replace('"', "'").strip()
    if not a.clear and not text:
        die("give flag text, or --clear")
    set_fm(node.directive, flag=f'"{text}"' if text else "")
    print(f"{'cleared flag on' if a.clear else 'flagged'} {node.id}")


def candidates(roots, agent=None):
    """(score, node, reason) for every node worth working, plus nodes waiting on a human."""
    picks, waiting = [], []
    for r in roots:
        for n, depth in r.walk():
            if n.held_by_other(agent):
                continue
            kids = n.children()
            ents = entries(n.read("NOTEBOOK.md"))
            nxt = entry_field(ents[-1], "Next") if ents else ""
            closed = n.status in CLOSED

            if n.flag:
                note = f" ({n.status}: claim with --force)" if closed else ""
                picks.append((100, depth, n, f"flagged: {n.flag}{note}"))
            elif n.changed and n.status == "blocked":
                picks.append((90, depth, n, "blocked, and the directive has since been updated"))
            elif not n.question:
                waiting.append((n, "needs a question"))
                continue
            elif n.human_note and not closed:
                picks.append((85, depth, n, f"human note in notebook: {n.human_note}"))
            elif n.changed and not closed:
                picks.append((80, depth, n, "directive updated since the last agent visit"))
            elif n.is_stale():
                picks.append((60, depth, n, f"stale claim by {n.fm.get('claimed_by')}; resume"
                              + (f" — next: {nxt}" if nxt else "")))
            elif n.status == "blocked":
                waiting.append((n, "blocked"))
            elif n.status == "open":
                open_kids = [k for k in kids if k.status not in CLOSED]
                if kids and not open_kids:
                    picks.append((55, depth, n, "all sub-paths closed; synthesise findings"))
                elif open_kids:
                    continue  # work happens in the children
                elif nxt:
                    picks.append((50, depth, n, f"in progress — next: {nxt}"))
                elif ents and not n.is_root:
                    picks.append((45, depth, n, "in progress"))
                else:
                    picks.append((40, depth, n, "plan sub-paths" if n.is_root else "not started"))
    picks.sort(key=lambda t: (-t[0], -t[1], t[2].id))
    return [(s, n, why) for s, _, n, why in picks], waiting


def cmd_sync(a):
    log, touched = sync()
    print("\n".join(log) if log else "nothing to sync")
    if log:
        commit(touched, "[sync] adopt nodes created in Obsidian", not a.no_commit)


def cmd_next(a):
    if not a.no_sync:
        log, touched = sync()
        if log:
            print("synced from Obsidian:\n" + "\n".join(f"  {l}" for l in log) + "\n")
            commit(touched, "[sync] adopt nodes created in Obsidian", not a.no_commit)
            print()
    roots = [resolve_node(a.node)] if a.node else question_roots()
    if not roots:
        print("no questions yet — in Obsidian, add a note to lab/questions/ (see README)")
        return
    picks, waiting = candidates(roots, a.agent)
    if picks:
        print(f"PICK UP: {picks[0][1].id}\n")
        for i, (_, n, why) in enumerate(picks[: a.limit], 1):
            print(f"{i}. {n.id}  [{status_tag(n)}]\n   why: {short(why, 110)}\n   question: {short(n.question, 100)}")
    else:
        print("NOTHING TO PICK UP: every node is closed, claimed, or waiting on a human.")
    if waiting:
        print("\nWaiting on a human:")
        for n, why in waiting:
            print(f"- {n.id}  [{why}]  {short(n.question, 80)}")


def cmd_log(a):
    node = resolve_node(a.node)
    heading = append_entry(node, a.agent, a.title)
    print(f"appended to {node.id}/NOTEBOOK.md:\n{heading}")


def cmd_run(a):
    node = resolve_node(a.node)
    check_slug(a.slug)
    run_id = f"{NOW.strftime('%Y%m%d-%H%M')}-{a.slug}"
    path = node.path / "runs" / run_id
    if path.exists():
        die(f"{rel(path)} already exists")
    (path / "raw").mkdir(parents=True)
    sha = git("rev-parse", "--short", "HEAD", check=False) or "none"
    if git("status", "--porcelain", check=False):
        sha += "-dirty"
    scaffold = git("rev-parse", "--short", "HEAD", check=False, cwd=ROOT)
    if scaffold:
        sha += f" (scaffold {scaffold})"
    run_md = path / "run.md"
    run_md.write_text(render("run.md"))
    set_fm(run_md, node=node.id, run=run_id, agent=a.agent, instrument=a.instrument, commit=sha)
    print(rel(path / "run.md"))


def cmd_tree(a):
    roots = [resolve_node(a.node)] if a.node else question_roots()
    if not roots:
        print("no questions yet — start one with: scripts/vm question <slug> \"<question>\"")
    for r in roots:
        for n, d in r.walk():
            name = n.id if d == 0 else n.path.name
            print(f"{'    ' * d}{name}  [{status_tag(n)}]  {short(n.question, 80)}")
        print()


def cmd_open(a):
    roots = [resolve_node(a.node)] if a.node else question_roots()
    found = False
    for r in roots:
        for n, _ in r.walk():
            if n.status == "open" or n.is_stale():
                leaf = "" if n.children() else " (leaf)"
                print(f"{n.id}  [{status_tag(n)}]{leaf}  {short(n.question, 80)}")
                found = True
    if not found:
        print("no open nodes")


def cmd_questions(a):
    for r in question_roots():
        nodes = [n for n, _ in r.walk()]
        counts = {}
        for n in nodes:
            counts[n.status] = counts.get(n.status, 0) + 1
        summary = ", ".join(f"{v} {k}" for k, v in sorted(counts.items()))
        print(f"{r.path.name}  [{r.status}]  {len(nodes)} nodes ({summary})")
        print(f"    {short(r.question, 100)}")


def cmd_index(a):
    lines = [
        "# Index", "",
        f"Generated by `scripts/vm index` on {NOW.strftime('%Y-%m-%d')}. Do not edit by hand.",
        "Live, editable tables: [Research.base](../Research.base).", "",
    ]

    def link(n, name="DIRECTIVE.md"):
        return f"{gitpath(n.path)}/{name}"

    roots = question_roots()
    if not roots:
        lines.append("No questions yet.")
    attention = [n for r in roots for n, _ in r.walk()
                 if n.flag or n.changed or n.human_note or n.status == "blocked" or not n.question]
    if attention:
        lines += ["## Needs attention", "",
                  "⚑ flagged · ✎ directive edited since an agent last looked · "
                  "✉ your note awaits an agent · blocked / no question = waiting on you", ""]
        for n in attention:
            why = (f"⚑ {n.flag}" if n.flag else "✎ edited" if n.changed else
                   f"✉ {n.human_note}" if n.human_note else "blocked" if n.status == "blocked" else "no question")
            lines.append(f"- [{n.id}]({link(n)}) · `{n.status}` · {why}")
        lines.append("")
    for r in roots:
        lines += [f"## [{r.id}]({link(r)}) · `{status_tag(r)}`", "", r.question, ""]
        for n, d in r.walk():
            if d == 0:
                continue
            lines.append(f"{'  ' * (d - 1)}- [{n.path.name}]({link(n)}) · "
                         f"`{status_tag(n)}` · {n.question} ([findings]({link(n, 'FINDINGS.md')}))")
        lines.append("")
    index = LAB / "INDEX.md"
    index.write_text("\n".join(lines).rstrip() + "\n")
    print(f"wrote {rel(index)}")
    commit([index], "[index] refresh", not a.no_commit)


def cmd_check(a):
    errors, warnings = [], []
    allow_rewrite = os.environ.get("VM_ALLOW_REWRITE") == "1"

    if a.repo and Path(a.repo).resolve() == ROOT:
        # Pre-commit in the public scaffold: research must never be committed here.
        staged = git("diff", "--cached", "--name-only", cwd=ROOT, check=False) or ""
        leaks = [f for f in staged.splitlines() if f == "lab" or f.startswith("lab/")]
        for f in leaks:
            print(f"error: {f}: lab/ is private research; commit it in the lab repo "
                  f"(git -C lab …), never in the public scaffold")
        sys.exit(1 if leaks else 0)

    for r in question_roots():
        stack = [r.path]
        while stack:
            d = stack.pop()
            n = Node(d)
            if not n.directive.exists():
                errors.append(f"{rel(d)}: folder has no DIRECTIVE.md (create nodes with "
                              f"`vm path`, or prefix non-node folders with _)")
                continue
            stack += [p for p in d.iterdir() if is_node_dir(p)]
            for f in NODE_FILES[1:]:
                if not (d / f).exists():
                    warnings.append(f"{n.id}: missing {f}")
            if n.status not in STATUSES:
                errors.append(f"{n.id}: status {n.status!r} is not one of {', '.join(STATUSES)}")
            if not n.question:
                warnings.append(f"{n.id}: no question set")
            if n.status == "active" and not n.fm.get("claimed_by"):
                warnings.append(f"{n.id}: active but claimed_by is empty")
            if n.is_stale():
                warnings.append(f"{n.id}: claim by {n.fm.get('claimed_by')} is stale "
                                f"({n.claim_age_hours():.0f}h)")
            if n.parent and f"{d.name}/DIRECTIVE.md" not in section(n.parent.text, "Sub-paths"):
                warnings.append(f"{n.id}: not listed in {n.parent.id}/DIRECTIVE.md › Sub-paths")

    # History rules, checked against HEAD for files that already exist there.
    def current(path):
        return git_show(f":{path}") if a.staged else (
            (LAB / path).read_text() if (LAB / path).exists() else None)

    tracked = git("ls-tree", "-r", "--name-only", "HEAD", "--", "questions", check=False) or ""
    for path in tracked.splitlines():
        name = path.rsplit("/", 1)[-1]
        if name not in ("NOTEBOOK.md", "DIRECTIVE.md"):
            continue
        old, new = git_show(f"HEAD:{path}"), current(path)
        if old is None:
            continue
        if new is None:
            if name == "NOTEBOOK.md" and not allow_rewrite:
                errors.append(f"lab/{path}: notebook deleted (set VM_ALLOW_REWRITE=1 if intended)")
            continue
        if name == "NOTEBOOK.md":
            if not split_fm(new)[1].rstrip().startswith(split_fm(old)[1].rstrip()) and not allow_rewrite:
                errors.append(f"lab/{path}: past entries were edited; notebooks are append-only "
                              f"(add a correcting entry instead)")
        else:
            gone = set(bullets(section(old, "Restricted"))) - set(bullets(section(new, "Restricted")))
            for b in sorted(gone):
                warnings.append(f"lab/{path}: restriction removed or reworded: {b}")
            if question_of(old) != question_of(new):
                warnings.append(f"lab/{path}: Question changed (human decision only)")

    for w in warnings:
        print(f"warning: {w}")
    for e in errors:
        print(f"error: {e}")
    if errors:
        sys.exit(1)
    if not a.staged or warnings:
        print(f"check: {len(errors)} errors, {len(warnings)} warnings")


# --------------------------------------------------------------------- main

def main():

    ap = argparse.ArgumentParser(prog="vm", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", metavar="command")
    sub.required = True

    def add(name, fn, help_):
        p = sub.add_parser(name, help=help_, description=help_)
        p.set_defaults(fn=fn)
        return p

    p = add("init", cmd_init, "create the private lab/ repo if missing and enable hooks (run once per clone)")
    p.add_argument("--remote", help="URL of a PRIVATE remote for lab/")

    p = add("commit", cmd_commit, "commit one node's changes to the lab repo")
    p.add_argument("node")
    p.add_argument("message", help='e.g. "log: first sweep"')

    p = add("question", cmd_question, "start a new question under questions/<slug>")
    p.add_argument("slug")
    p.add_argument("question")
    p.add_argument("--no-commit", action="store_true")

    p = add("path", cmd_path, "add a sub-path (child node) under a node")
    p.add_argument("parent")
    p.add_argument("slug")
    p.add_argument("question", help="the child's question; also its scope line in the parent")
    p.add_argument("--agent", default="vm", help="who is spawning it (for the parent's notebook)")

    p = add("context", cmd_context, "print everything an agent must read before working a node")
    p.add_argument("node")
    p.add_argument("--entries", type=int, default=5, help="recent notebook entries to show")

    p = add("claim", cmd_claim, "mark a node active for an agent (commits)")
    p.add_argument("node")
    p.add_argument("agent")
    p.add_argument("--force", action="store_true", help="take over a live claim or reopen a closed node")
    p.add_argument("--no-commit", action="store_true")

    p = add("release", cmd_release, "release a claim and set the node's status (commits)")
    p.add_argument("node")
    p.add_argument("agent")
    p.add_argument("--status", default="open", choices=[s for s in STATUSES if s != "active"])
    p.add_argument("--summary", help="one-line result for the parent's Closed paths")
    p.add_argument("--keep-flag", action="store_true", help="leave the human flag set (not yet addressed)")
    p.add_argument("--force", action="store_true")
    p.add_argument("--no-commit", action="store_true")

    p = add("next", cmd_next, "rank where to pick up work: flags, directive edits, unfinished nodes")
    p.add_argument("node", nargs="?", help="limit to a question or subtree")
    p.add_argument("--agent", help="your id, so your own claims are not skipped")
    p.add_argument("--limit", type=int, default=5)
    p.add_argument("--no-sync", action="store_true", help="skip adopting Obsidian-made notes first")
    p.add_argument("--no-commit", action="store_true", help="sync without committing")

    p = add("sync", cmd_sync, "adopt notes and folders created in Obsidian as proper nodes")
    p.add_argument("--no-commit", action="store_true")

    p = add("flag", cmd_flag, "flag a node for agent attention (same as setting `flag:` in Obsidian)")
    p.add_argument("node")
    p.add_argument("text", nargs="*")
    p.add_argument("--clear", action="store_true")

    p = add("log", cmd_log, "append a notebook entry skeleton")
    p.add_argument("node")
    p.add_argument("agent")
    p.add_argument("title")

    p = add("run", cmd_run, "create a run record: <node>/runs/<timestamp>-<slug>/run.md")
    p.add_argument("node")
    p.add_argument("slug")
    p.add_argument("--agent", default="")
    p.add_argument("--instrument", default="")

    p = add("tree", cmd_tree, "show nodes with status and claims")
    p.add_argument("node", nargs="?")

    p = add("open", cmd_open, "list nodes free to claim (open or stale)")
    p.add_argument("node", nargs="?")

    add("questions", cmd_questions, "one line per question")
    p = add("index", cmd_index, "regenerate lab/INDEX.md and commit it")
    p.add_argument("--no-commit", action="store_true")

    p = add("check", cmd_check, "lint structure and history rules")
    p.add_argument("--staged", action="store_true", help="check the index (used by the pre-commit hook)")
    p.add_argument("--repo", help="repo the hook is running in (set by the pre-commit hook)")

    a = ap.parse_args()
    scaffold_hook = a.cmd == "check" and a.repo and Path(a.repo).resolve() == ROOT
    if a.cmd != "init" and not scaffold_hook and not (LAB / ".git").exists():
        die("no lab yet — run: scripts/vm init")
    a.fn(a)


if __name__ == "__main__":
    main()
